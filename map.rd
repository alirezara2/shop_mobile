shop/
├── .htaccess               (امنیت و ریدایرکت)
├── robots.txt              (تنظیمات موتور جستجو)
├── manifest.json           (وب‌اپ موبایل)
├── config.php              (تنظیمات دیتابیس، زرین‌پال، کاوه‌نگار)
├── install.php             (نصب خودکار دیتابیس)
├── database.sql            (ساختار جداول و داده‌های اولیه)
├── index.php               (صفحه اصلی با ۴ ردیف محصول)
├── product.php             (صفحه جزئیات محصول)
├── category.php            (آرشیو محصولات با فیلتر پیشرفته)
├── brand.php               (صفحه اختصاصی هر برند)
├── cart.php                (سبد خرید)
├── checkout.php            (تکمیل سفارش)
├── verify.php              (تأیید پرداخت زرین‌پال)
├── profile.php             (داشبورد کاربر + احراز هویت)
├── track.php               (رهگیری سفارش)
├── page.php                (صفحات ثابت مثل درباره ما، تماس با ما)
├── api.php                 (پردازش‌های Ajax)
├── admin.php               (کل پنل ادمین)
├── assets/
│   ├── style.css           (استایل کل سایت)
│   ├── admin.css           (استایل پنل ادمین)
│   └── app.js              (اسکریپت‌های سایت)
└── uploads/                (محل ذخیره عکس محصولات)